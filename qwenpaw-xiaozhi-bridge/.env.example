# ============================================================
# QwenPaw <-> 小智(ESP32) 桥接服务 配置文件
# 复制为 .env 后按需修改
# ============================================================

# ---------- 桥接服务监听 ----------
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8089

# 设备接入令牌（留空 = 不校验）
# 与固件 menuconfig -> QwenPaw Bridge Server -> token 保持一致
BRIDGE_TOKEN=

# ---------- QwenPaw 服务 ----------
# QwenPaw 部署地址（本机部署保持默认即可，localhost 免鉴权）
QWENPAW_BASE_URL=http://127.0.0.1:8088
# 控制台左上角选择的智能体 ID
QWENPAW_AGENT_ID=xiaozhi
# QwenPaw 开启了 Web 登录认证且跨机访问时才需要填写
QWENPAW_API_TOKEN=
# 对话走哪个通道（console 通道默认启用）
QWENPAW_CHANNEL=console

# ---------- 语音方案 ----------
# TTS 引擎（可选其一）：
#   edge        微软 edge-tts，免费无额度限制（默认，推荐）
#   siliconflow 硅基流动 CosyVoice2，免费额度，国内直连
#   piper       本地 Piper，完全离线（需下载模型：pip install piper-tts）
#   melo        本地 MeloTTS，完全离线（需下载模型：pip install sherpa-onnx）
#   dashscope   阿里云百炼 CosyVoice（需付费额度，不建议）
TTS_PROVIDER=edge
# edge-tts 音色（免费）：
#   zh-CN-XiaoxiaoNeural(女)  zh-CN-YunxiNeural(男)
#   zh-CN-YunyangNeural(新闻男) zh-CN-XiaoyiNeural(女童)
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# 下行音频采样率 16000 / 24000
TTS_SAMPLE_RATE=24000

# ---- 硅基流动 TTS（TTS_PROVIDER=siliconflow 或 edge 回退时使用）----
# API Key：https://cloud.siliconflow.cn/ 注册后获取（留空时复用下方 ASR_TRANSCRIBE_KEY）
SILICONFLOW_API_KEY=
# 硅基流动 TTS 音色（CosyVoice2-0.5B 系统预设：alex/anna/bella/benjamin/charles/claire/david/diana）
SILICONFLOW_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:claire
# edge-tts 失败时的备选 TTS（siliconflow / 留空禁用）
TTS_FALLBACK_PROVIDER=siliconflow

# ---- 本地 Piper（TTS_PROVIDER=piper 时使用）----
# .onnx 模型路径，需同目录放同名 .onnx.json（中文推荐 zh_CN-huayan-medium）
# 下载：https://huggingface.co/rhasspy/piper-voices/tree/main/zh/zh_CN/huayan/medium
PIPER_MODEL_PATH=models/zh_CN-huayan-medium.onnx

# ---- 本地 MeloTTS（TTS_PROVIDER=melo 时使用）----
# 模型目录（需含 model.onnx / tokens.txt / lexicon.txt / dict/）
# 下载：https://github.com/k2-fsa/sherpa-onnx/releases
#   vits-melo-tts-zh_en.tar.bz2 解压后把目录填到下面
MELO_MODEL_DIR=
# 发音人 ID（vits-melo-tts-zh_en：0-4 为英文口音，100 为中文女声）
MELO_SPEAKER_ID=100
# 语速（1.0 正常）
MELO_SPEED=1.0

# ASR 引擎：auto（有 ASR_TRANSCRIBE_KEY 用免费转写，否则 DashScope）
#   / transcribe（免费转写 API）/ dashscope（百炼流式）
ASR_PROVIDER=auto
# 免费转写 API（默认 SiliconFlow SenseVoice，国内直连免费）
# https://cloud.siliconflow.cn/ 注册后 API-KEY 页面获取，填入下行即可切换为全免费
ASR_TRANSCRIBE_URL=https://api.siliconflow.cn/v1/audio/transcriptions
ASR_TRANSCRIBE_MODEL=iic/SenseVoiceSmall
ASR_TRANSCRIBE_KEY=
# 也兼容其它 OpenAI 风格 /audio/transcriptions 服务，例如 Groq：
#   ASR_TRANSCRIBE_URL=https://api.groq.com/openai/v1/audio/transcriptions
#   ASR_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ---------- DashScope（仅 ASR/TTS 走 dashscope 时需要） ----------
# https://bailian.console.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=
# 语音识别（实时流式）
ASR_MODEL=paraformer-realtime-v2
# 语音合成（CosyVoice）
TTS_MODEL=cosyvoice-v2
# 音色（cosyvoice-v2 必须用 _v2 后缀音色）：
# longxiaochun_v2(小淳) longwan_v2(万) longcheng_v2(诚) longhua_v2(桦)...
TTS_VOICE=longxiaochun_v2

# ---------- 高级 ----------
# 自动模式下，识别到一句话结束后等待多少秒静音才算说完
UTTERANCE_SILENCE=0.8
# 服务端 VAD 兜底：识别到语音后，超过该时长仍未判定"说话结束"则强制收口。
# 防止环境噪声导致一直等静音（真机曾出现 44 秒延迟）。取值范围 5.0 ~ 60.0 秒。
VAD_MAX_UTTERANCE_SEC=20.0
# 调用设备 MCP 工具的超时（秒）
MCP_TIMEOUT=30
# 日志级别 DEBUG / INFO / WARNING
LOG_LEVEL=INFO
