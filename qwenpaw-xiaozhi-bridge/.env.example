# ============================================================
# QwenPaw <-> 小智(ESP32) 桥接服务 配置文件
# 复制为 .env 后按需修改
# ============================================================

# ---------- 桥接服务监听 ----------
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000

# 设备接入令牌（留空 = 不校验）
# 与固件 menuconfig -> QwenPaw Bridge Server -> token 保持一致
BRIDGE_TOKEN=

# ---------- QwenPaw 服务 ----------
# QwenPaw 部署地址（本机部署保持默认即可，localhost 免鉴权）
QWENPAW_BASE_URL=http://127.0.0.1:8088
# 控制台左上角选择的智能体 ID
QWENPAW_AGENT_ID=default
# QwenPaw 开启了 Web 登录认证且跨机访问时才需要填写
QWENPAW_API_TOKEN=
# 对话走哪个通道（console 通道默认启用）
QWENPAW_CHANNEL=console

# ---------- DashScope 语音（阿里云百炼） ----------
# https://bailian.console.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxx

# 语音识别（实时流式）
ASR_MODEL=paraformer-realtime-v2
# 语音合成（CosyVoice）
TTS_MODEL=cosyvoice-v2
# 音色：longxiaochun(小淳) longwan(万) longcheng(诚) longhua(桦)...
TTS_VOICE=longxiaochun
# 下行音频采样率 16000 / 24000
TTS_SAMPLE_RATE=24000

# ---------- 高级 ----------
# 自动模式下，识别到一句话结束后等待多少秒静音才算说完
UTTERANCE_SILENCE=0.8
# 调用设备 MCP 工具的超时（秒）
MCP_TIMEOUT=30
# 日志级别 DEBUG / INFO / WARNING
LOG_LEVEL=INFO
